# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB must be a replica set (transactions). `npm run db:local` starts one at this URI.
# Atlas (any tier) also works: mongodb+srv://<user>:<password>@<cluster>/hotel?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/hotel?replicaSet=rs0&directConnection=true
MONGO_MAX_POOL_SIZE=20

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=<replace-with-a-long-random-secret>
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

HOTEL_TIMEZONE=Asia/Kolkata
HOTEL_CURRENCY=INR
BOOKING_WINDOW_DAYS=365
MAX_STAY_NIGHTS=30
MAX_ROOMS_PER_BOOKING=5
# false: bookings start PENDING (inventory held) until staff confirm. true: start CONFIRMED.
AUTO_CONFIRM_BOOKINGS=false

# Set true when running behind a load balancer / reverse proxy (correct client IPs for rate limits).
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Used only by `npm run seed` (development data).
SEED_ADMIN_EMAIL=admin@hotel.local
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_STAFF_EMAIL=frontdesk@hotel.local
SEED_STAFF_PASSWORD=<choose-a-password>
SEED_GUEST_EMAIL=guest@hotel.local
SEED_GUEST_PASSWORD=<choose-a-password>

# Used only by `npm run demo:concurrency` (talks to a running API).
DEMO_API_URL=http://localhost:4000
DEMO_STAFF_EMAIL=frontdesk@hotel.local
DEMO_STAFF_PASSWORD=<same-as-SEED_STAFF_PASSWORD>
